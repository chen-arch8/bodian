#!name=波点音乐签到
#!desc=版本 2026-11-21.r5 · 每日签到+听歌奖励+惊喜宝箱+免费抽奖+吃饭领金币,支持多账号。首次使用:打开波点音乐App「赚钱(金币)」页面,收到「✅ 获取凭据成功」即完成,然后关掉「抓取凭据」开关(拦截规则随之停用);每天 8/13/19/22 点自动执行,手动运行在 Loon 脚本页右上角 ▶。凭据失效重开抓取开关再打开赚钱页即可自动更新。
#!author=chen-arch8
#!homepage=https://github.com/chen-arch8/bodian
#!icon=https://raw.githubusercontent.com/chen-arch8/bodian/main/icon.png
#!loon_version = 3.5.1(983)
#!version = 1.3.0
#!date = 2026-11-21
#!tag=签到, Cookie

[Argument]

capture = switch,true,tag=抓取凭据,desc=抓完就关(拦截规则随之停用);失效重抓时再打开
lottery = switch,true,tag=免费抽奖,desc=每日免费次数抽完即停,看广告的不做
dine = switch,true,tag=吃饭领金币,desc=自动领当前饭点+连吃奖励
box_times = input,"3",tag=宝箱尝试次数,desc=1~5,宝箱有冷却时间
debug = switch,false,tag=调试模式,desc=把每次API响应原文写进脚本日志,排查问题用
clear = switch,false,tag=清除凭据,desc=开启后下次运行清空全部已存账号

[Script]

request if ${url} ~= /^https?:\/\/bd-api\.kuwo\.cn\/api\/advert\/earning/i then script("https://raw.githubusercontent.com/chen-arch8/bodian/main/bodian.js?v=6") with enable=${capture}, tag="波点音乐凭据"

cron "0 8,13,19,22 * * *" then script("https://raw.githubusercontent.com/chen-arch8/bodian/main/bodian.js?v=6", {${lottery}, ${dine}, ${box_times}, ${debug}, ${clear}}) with tag="波点音乐任务", timeout=120

[MITM]

hostname = bd-api.kuwo.cn
