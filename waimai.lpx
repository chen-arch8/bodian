#!name = 外卖霸王餐合集(小蚕+歪麦)
#!desc = 小蚕霸王餐+歪麦吧霸王餐 每日签到/任务/开宝箱。用法:开「小蚕·凭据捕获」打开小蚕App刷一下→收到✅→关闭;开「歪麦·凭据捕获」打开歪麦App进「我的」页→收到✅→关闭;手动运行「每日任务」看日志。每天 08:37(小蚕)/ 08:52(歪麦) 自动执行。凭据失效重复上述操作。
#!author = chen-arch8(脚本引擎: Sliverkiss)
#!homepage = https://github.com/chen-arch8/bodian
#!icon = https://raw.githubusercontent.com/chen-arch8/bodian/main/icon.png
#!loon_version = 3.5.1(983)
#!version = 1.0.0
#!date = 2026-11-21
#!tag = 外卖霸王餐, 签到

[Argument]

xc_capture = switch,true,tag=小蚕·凭据捕获,desc=抓完可关;凭据失效时重开再刷一次 App
wm_capture = switch,true,tag=歪麦·凭据捕获,desc=抓完可关;凭据失效时重开再进一次「我的」页
debug = switch,false,tag=调试模式,desc=保留脚本自带日志

[Script]

response if ${url} ~= /^https:\/\/gw\.xiaocantech\.com\/rpc/ then script("https://gist.githubusercontent.com/Sliverkiss/27c601d97a3f8960b212e5cac5b6c470/raw/xcbwc.js?v=1") with enable=${xc_capture}, tag="小蚕·凭据捕获", requires_body=true

request if ${url} ~= /^https:\/\/wmapp-api\.waimaimingtang\.com\/api\/api\/v2\/user\/api_user_info_one/ then script("https://gist.githubusercontent.com/Sliverkiss/49a9ffb2169a2becc33bf4fdbf6eb99a/raw/wmbwc.js?v=1") with enable=${wm_capture}, tag="歪麦·凭据捕获", requires_body=true

cron "37 8 * * *" then script("https://gist.githubusercontent.com/Sliverkiss/27c601d97a3f8960b212e5cac5b6c470/raw/xcbwc.js?v=1") with tag="小蚕·每日任务", timeout=600

cron "52 8 * * *" then script("https://gist.githubusercontent.com/Sliverkiss/49a9ffb2169a2becc33bf4fdbf6eb99a/raw/wmbwc.js?v=1") with tag="歪麦·每日任务", timeout=600

[MITM]

hostname = gw.xiaocantech.com, wmapp-api.waimaimingtang.com
