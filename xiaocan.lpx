#!name = 小蚕霸王餐
#!desc = 小蚕霸王餐每日任务(签到/元宝乐园/看广告任务),脚本引擎来自 Sliverkiss 的 gist(2026-06-14 版,内部为混淆代码,由其自行维护)。用法:装好后打开小蚕霸王餐 App 随便刷一下(自动捕获凭据)→ 手动运行「小蚕·每日任务」看日志是否正常。每天 08:37 自动执行。⚠️ 脚本来自第三方 gist,内部逻辑未审计,自行斟酌使用;完整免责声明见仓库 DISCLAIMER.md。
#!author = chen-arch8(脚本引擎: Sliverkiss)
#!homepage = https://github.com/chen-arch8/bodian
#!icon = https://raw.githubusercontent.com/chen-arch8/bodian/main/icon.png
#!loon_version = 3.5.1(983)
#!version = 1.0.0
#!date = 2026-11-22
#!tag = 外卖霸王餐, 签到

[Argument]

capture = switch,true,tag=凭据捕获,desc=抓完可关;凭据失效(任务报错)时重开再刷一次 App
debug = switch,false,tag=调试模式,desc=保留脚本自带日志

[Script]

response if ${url} ~= /^https:\/\/gw\.xiaocantech\.com\/rpc/ then script("https://gist.githubusercontent.com/Sliverkiss/27c601d97a3f8960b212e5cac5b6c470/raw/xcbwc.js?v=20261122") with enable=${capture}, tag="小蚕·凭据捕获", requires_body=true

cron "37 8 * * *" then script("https://gist.githubusercontent.com/Sliverkiss/27c601d97a3f8960b212e5cac5b6c470/raw/xcbwc.js?v=20261122", {${capture}, ${debug}}) with tag="小蚕·每日任务", timeout=600

[MITM]

hostname = gw.xiaocantech.com
